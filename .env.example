# LinkedIn Agent Toolkit Configuration (Optional)
# This project does NOT store passwords or private tokens. All authentication occurs safely in your local browser.

# Chrome DevTools Protocol port (Default: 9222)
LINKEDIN_CDP_PORT=9222

# Chrome DevTools Protocol URL (Default: http://127.0.0.1:9222)
LINKEDIN_CDP_URL=http://127.0.0.1:9222

# Custom directory for isolated Chrome profile
# LINKEDIN_CHROME_DATA_DIR=/path/to/custom/profile

# Custom Chrome executable path (optional, auto-detected by default)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
